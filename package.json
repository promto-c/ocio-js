{
  "name": "@bb-studio/ocio",
  "version": "0.0.5",
  "description": "OpenColorIO 2.5 WebAssembly bindings for browser and Node.js.",
  "type": "module",
  "types": "./src/ocio-js.d.ts",
  "imports": {
    "#ocio-wasm": {
      "node": "./dist/ocio-wasm.node.js",
      "default": "./dist/ocio-wasm.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/ocio-js.d.ts",
      "vite": "./src/index.vite.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "test": "node --test test/*.test.js",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "serve:demo": "node scripts/serve-demo.mjs"
  },
  "keywords": [
    "OpenColorIO",
    "OCIO",
    "ACES",
    "wasm",
    "color-management"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promto-c/ocio-js.git"
  },
  "bugs": {
    "url": "https://github.com/promto-c/ocio-js/issues"
  },
  "homepage": "https://github.com/promto-c/ocio-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/ocio-wasm.js",
    "dist/ocio-wasm.node.js",
    "dist/ocio-wasm.wasm",
    "src/index.js",
    "src/index.vite.js",
    "src/wasm-url.js",
    "src/wasm-url.vite.js",
    "src/ocio-js.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "patches/opencolorio/0001-webgl-glsl-es-float-literals.patch",
    "patches/opencolorio/README.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
