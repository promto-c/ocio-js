{
  "name": "@bb-studio/ocio",
  "version": "0.0.9",
  "description": "OpenColorIO 2.5.2 WebAssembly bindings with CPU, GPU shader extraction, and WebGPU/WGSL support.",
  "type": "module",
  "types": "./src/ocio-js.d.ts",
  "imports": {
    "#ocio-wasm": {
      "node": "./dist/ocio-wasm.node.js",
      "default": "./dist/ocio-wasm.js"
    },
    "#naga-runtime": {
      "node": "./src/naga-runtime.node.js",
      "default": "./src/naga-runtime.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/ocio-js.d.ts",
      "vite": "./src/index.vite.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./webgpu": {
      "types": "./src/webgpu.d.ts",
      "default": "./src/webgpu.js"
    }
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "test": "node --test test/*.test.js",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "serve:demo": "node scripts/serve-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "npm run build:demo && node scripts/serve-demo.mjs --static",
    "build:naga": "bash scripts/build-naga.sh",
    "build": "npm run build:naga && npm run build:wasm"
  },
  "keywords": [
    "OpenColorIO",
    "OCIO",
    "ACES",
    "wasm",
    "color-management",
    "webgpu",
    "wgsl"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promto-c/ocio-js.git"
  },
  "bugs": {
    "url": "https://github.com/promto-c/ocio-js/issues"
  },
  "homepage": "https://github.com/promto-c/ocio-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/ocio-wasm.js",
    "dist/ocio-wasm.node.js",
    "dist/ocio-wasm.wasm",
    "src/index.js",
    "src/index.vite.js",
    "src/wasm-url.js",
    "src/wasm-url.vite.js",
    "src/ocio-js.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "dist/naga-wasm.js",
    "dist/naga-wasm_bg.wasm",
    "src/naga-runtime.js",
    "src/naga-runtime.node.js",
    "src/webgpu.js",
    "src/webgpu-shader.js",
    "src/webgpu.d.ts"
  ],
  "engines": {
    "node": ">=20"
  }
}
